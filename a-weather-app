#!/usr/bin/bash
# Source-checkout launcher. The packaged command is the compiled Go executable.
set -euo pipefail
app_source=$(dirname -- "$(realpath -- "$0")")
if [[ ! -x "$app_source/build/a-weather-app" ]]; then
  printf 'Build the Go/Qt application first with make, or use the container-built package.\n' >&2
  exit 1
fi
exec "$app_source/build/a-weather-app" "$@"
